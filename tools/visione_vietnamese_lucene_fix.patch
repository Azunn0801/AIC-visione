+		public static String normalizeVietnamese(String text) {
+		if (text == null) return "";
+		String s = text.toLowerCase(java.util.Locale.ROOT)
+				.replace('đ', 'd')
+				.replace('Đ', 'd');
+		s = java.text.Normalizer.normalize(s, java.text.Normalizer.Form.NFKD);
+		s = s.replaceAll("\\p{M}", "");
+		// Replace non-alphanumeric with space
+		s = s.replaceAll("[^a-z0-9\\s]", " ");
+		return s.trim();
+	}
+
+	/** Search media-info metadata and return normal VisioNe frame results. */
+	public SearchResults[] searchMetadata(String textQuery, int k) throws IOException {
+		String value = textQuery == null ? "" : textQuery.trim();
+		if (value.isEmpty())
+			return new SearchResults[0];
+
+		// Mojibake self-healing fallback
+		if (value.contains("Ã") || value.contains("Â") || value.contains("á»") || value.contains("Ä")) {
+			try {
+				value = new String(value.getBytes(java.nio.charset.StandardCharsets.ISO_8859_1), java.nio.charset.StandardCharsets.UTF_8);
+			} catch (Exception ignored) {}
+		}
+
+		String clean = normalizeVietnamese(value);
+		String[] terms = clean.split("\\s+");
+		List<String> validTerms = new ArrayList<>();
+		for (String t : terms) {
+			if (!t.trim().isEmpty()) {
+				validTerms.add(t.trim());
+			}
+		}
+		if (validTerms.isEmpty())
+			return new SearchResults[0];
+
+		BooleanQuery.Builder mainBuilder = new BooleanQuery.Builder();
+		BooleanClause.Occur termOccur = (validTerms.size() <= 2)
+				? BooleanClause.Occur.MUST
+				: BooleanClause.Occur.SHOULD;
+
+		for (String term : validTerms) {
+			BooleanQuery.Builder termOr = new BooleanQuery.Builder();
+			termOr.add(new TermQuery(new Term(Fields.MEDIA_INFO_NORM, term)), BooleanClause.Occur.SHOULD);
+			if (term.contains("d")) {
+				termOr.add(new TermQuery(new Term(Fields.MEDIA_INFO_NORM, term.replace('d', 'đ'))), BooleanClause.Occur.SHOULD);
+			}
+			mainBuilder.add(termOr.build(), termOccur);
+		}
+
+		TopDocs hits = s.search(mainBuilder.build(), k);
+
+		// Fallback: If MUST returned 0 results for 2-word query, try SHOULD
+		if (hits.totalHits == 0 && validTerms.size() <= 2 && validTerms.size() > 1) {
+			BooleanQuery.Builder fallbackBuilder = new BooleanQuery.Builder();
+			for (String term : validTerms) {
+				BooleanQuery.Builder termOr = new BooleanQuery.Builder();
+				termOr.add(new TermQuery(new Term(Fields.MEDIA_INFO_NORM, term)), BooleanClause.Occur.SHOULD);
+				if (term.contains("d")) {
+					termOr.add(new TermQuery(new Term(Fields.MEDIA_INFO_NORM, term.replace('d', 'đ'))), BooleanClause.Occur.SHOULD);
+				}
+				fallbackBuilder.add(termOr.build(), BooleanClause.Occur.SHOULD);
+			}
+			hits = s.search(fallbackBuilder.build(), k);
+		}
+
+		return topDocs2SearchResults(hits, k);
+	}
